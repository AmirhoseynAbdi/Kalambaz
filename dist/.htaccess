<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve Authorization header for PHP on cPanel / LiteSpeed / FastCGI
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Route /api/* requests to the cPanel PHP backend (api/index.php)
  RewriteCond %{REQUEST_URI} ^/api/(.*)$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

  # Standard SPA routing for React frontend
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
